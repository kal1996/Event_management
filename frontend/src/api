    return response.data;
  },

  async create(eventData) {
    const response = await api.post('/admin/add-event', eventData);
    return response.data;
  },

  async update(eventId, eventData) {
    const response = await api.put(`/admin/update-event/${eventId}`, eventData);
    return response.data;
  },

  async delete(eventId) {
    const response = await api.delete(`/admin/delete-event/${eventId}`);
    return response.data;
  },
};

